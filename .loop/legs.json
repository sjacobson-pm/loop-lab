{
    "version": 2,
    "entry": "plan",
    "budgets": {
        "cycle": 3,
        "total": 15
    },
    "legs": {
        "stub": {
            "_comment": "not a 'real' leg, retained only so check-loop has a leg to drive.",
            "workflow": "loop-leg-stub.yml",
            "facts": {
                "required": [
                    "failing_tests",
                    "error_kind",
                    "error_text"
                ],
                "signature": [
                    "failing_tests",
                    "error_kind",
                    "error_text"
                ],
                "normalize": "test_output"
            }
        },
        "plan": {
            "workflow": "loop-leg-plan.lock.yml",
            "facts": {
                "required": [
                    "reason_codes",
                    "at_fault_criteria"
                ],
                "signature": [
                    "reason_codes",
                    "at_fault_criteria"
                ],
                "normalize": "identifiers"
            }
        }
    },
    "transitions": [
        {
            "from": "plan",
            "on": "pass",
            "to": "__done__",
            "kind": "forward"
        },
        {
            "from": "plan",
            "on": "fail",
            "to": "plan",
            "kind": "backward"
        },
        {
            "from": "stub",
            "on": "pass",
            "to": "__done__",
            "kind": "forward"
        },
        {
            "from": "stub",
            "on": "fail",
            "to": "stub",
            "kind": "backward"
        }
    ],
    "_phase2_shape": {
        "_comment": "Reference only. Ignored by loop-decide.mjs. Move entries into legs/transitions one leg at a time.",
        "legs": {
            "plan-check": {
                "workflow": "loop-leg-plan-check.yml",
                "facts": {
                    "_comment": "Rule ids and criterion anchors are already canonical. Text normalization would only add noise.",
                    "required": [
                        "violated_rules",
                        "criterion_ids"
                    ],
                    "signature": [
                        "violated_rules",
                        "criterion_ids"
                    ],
                    "normalize": "identifiers"
                }
            },
            "acceptance": {
                "workflow": "loop-leg-acceptance.yml",
                "facts": {
                    "_comment": "uncovered_criteria drives the signature; red_first_failures is diagnostic and deliberately excluded so a flaky red-first count cannot change breaker behavior.",
                    "required": [
                        "uncovered_criteria"
                    ],
                    "signature": [
                        "uncovered_criteria"
                    ],
                    "normalize": "identifiers"
                }
            },
            "implement": {
                "workflow": "loop-leg-implement.yml",
                "facts": {
                    "_comment": "Implementer failure means it could not proceed - scope violation, missing contract, dispute raised. Test failures belong to verify.",
                    "required": [
                        "at_fault_criteria",
                        "reason_codes",
                        "disputed_criteria"
                    ],
                    "signature": [
                        "at_fault_criteria",
                        "reason_codes",
                        "disputed_criteria"
                    ],
                    "normalize": "identifiers"
                }
            },
            "verify": {
                "workflow": "loop-leg-verify.yml",
                "facts": {
                    "required": [
                        "failing_tests",
                        "error_kind",
                        "error_text"
                    ],
                    "signature": [
                        "failing_tests",
                        "error_kind",
                        "error_text"
                    ],
                    "normalize": "test_output"
                }
            }
        },
        "transitions": [
            {
                "from": "plan",
                "on": "pass",
                "to": "plan-check",
                "kind": "forward"
            },
            {
                "from": "plan-check",
                "on": "pass",
                "to": "acceptance",
                "kind": "forward"
            },
            {
                "from": "plan-check",
                "on": "fail",
                "to": "plan",
                "kind": "backward"
            },
            {
                "from": "acceptance",
                "on": "pass",
                "to": "implement",
                "kind": "forward"
            },
            {
                "from": "acceptance",
                "on": "fail",
                "to": "plan",
                "kind": "backward"
            },
            {
                "from": "implement",
                "on": "pass",
                "to": "verify",
                "kind": "forward"
            },
            {
                "from": "implement",
                "on": "fail",
                "to": "plan",
                "kind": "backward"
            },
            {
                "from": "verify",
                "on": "pass",
                "to": "__done__",
                "kind": "forward"
            },
            {
                "from": "verify",
                "on": "fail",
                "to": "implement",
                "kind": "backward"
            }
        ]
    }
}